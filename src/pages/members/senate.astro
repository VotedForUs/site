---
/**
 * The Senate roster: every senator with a recorded vote, by surname.
 *
 * The rows are the finder's own — read from the index it is built from, so a
 * member appears here exactly when the finder can find them, and says
 * current or former in both places.
 */
import Layout from '../../layouts/Layout.astro';
import ResultGroup from '../../components/ResultGroup.astro';
import MemberResultRow from '../../components/MemberResultRow.astro';
import { readFinderIndex } from '../../utils/finderIndex';
import { memberStatus } from '../../utils/finderMatch/index.js';

const base = import.meta.env.BASE_URL;
const members = (readFinderIndex().members ?? []).filter((row) => row.c === 'senate');
const former = members.filter((row) => memberStatus(row) === 'former').length;
---

<Layout title="Senate — VotedFor.Us" description="Senators of the 119th Congress who have a recorded vote on this site">
  <section class="section stack">
    <h1>United States Senate</h1>
    <p>
      {members.length} senators with a recorded vote in the 119th Congress{former > 0 && `, ${former} of whom no longer hold a seat`}.
      Each name opens that member’s record.
    </p>
    {members.length > 0
      ? (
        <ResultGroup label="senators" count={members.length}>
          {members.map((row) => <MemberResultRow row={row} base={base} />)}
        </ResultGroup>
      )
      : <p>The roster is unavailable right now. <a href={base}>Search for a member</a> instead.</p>}
  </section>
</Layout>
