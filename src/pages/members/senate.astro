---
import Layout from '../../layouts/Layout.astro';
import LegislatorList from '../../components/LegislatorList.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

let senators: CollectionEntry<'senators'>[] = [];

try {
  senators = await getCollection('senators');
} catch (error) {
  console.error('Error loading senators:', error);
}
---

<Layout title="Senate — VotedFor.Us" description="Current members of the United States Senate">
  <section class="section stack">
    <h1>United States Senate</h1>
    <p>{senators.length} current senators. Each name opens that member’s recorded votes.</p>
    <LegislatorList legislators={senators} />
  </section>
</Layout>
