---
import Layout from '../../layouts/Layout.astro';
import LegislatorList from '../../components/LegislatorList.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

let representatives: CollectionEntry<'representatives'>[] = [];

try {
  representatives = await getCollection('representatives');
} catch (error) {
  console.error('Error loading representatives:', error);
}
---

<Layout title="House — VotedFor.Us" description="Current members of the United States House of Representatives">
  <section class="section stack">
    <h1>United States House of Representatives</h1>
    <p>{representatives.length} current representatives. Each name opens that member’s recorded votes.</p>
    <LegislatorList legislators={representatives} />
  </section>
</Layout>
