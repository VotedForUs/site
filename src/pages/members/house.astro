---
import Layout from '../../layouts/Layout.astro';
import LegislatorList from '../../components/LegislatorList.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

let representatives: CollectionEntry<'representatives'>[] = [];

try {
  representatives = await getCollection('representatives');
} catch (error) {
  console.error('Error loading representatives:', error);
}
---

<Layout title="House of Representatives - Congressional Vote Analysis" description="Current members of the United States House of Representatives">
  <h2>United States House of Representatives</h2>
  <p>Current members of the House of Representatives ({representatives.length} members)</p>

  <LegislatorList legislators={representatives} />
</Layout>
