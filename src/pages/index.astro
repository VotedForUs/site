---
/**
 * Home, and the only home the finder has: every member of the 119th is listed
 * here on load, and the field narrows the list from the first character.
 *
 * The page is prerendered, so `?q=` and `?type=` are read by `vfu-finder` at
 * runtime rather than here — the finder writes them as the reader searches, so
 * a search is a link someone can send.
 */
import Layout from '../layouts/Layout.astro';
import VfuFinder from '../components/finder/VfuFinder.astro';
import { readFinderCounts } from '../utils/finderIndex.js';

const base = import.meta.env.BASE_URL;
const counts = readFinderCounts();
---

<Layout title="Every recorded vote of the 119th Congress">
  <section class="section stack">
    <h2>Every recorded vote of the 119th Congress</h2>
    {counts && (
      <p class="finder-corpus">
        {counts.members} members · {counts.bills} bills · every recorded vote on them
      </p>
    )}

    <VfuFinder urlState />

    <nav class="finder-hubs">
      <h3>Or browse</h3>
      <ul>
        <li><a href={`${base}members`}>All members</a> — by chamber, Senate and House</li>
        <li><a href={`${base}bills/119`}>All bills of the 119th</a> — grouped by what happened to them</li>
        <li><a href={`${base}about`}>Where this data comes from</a></li>
      </ul>
    </nav>
  </section>
</Layout>

<style>
  .finder-corpus {
    margin: 0;
    font-family: var(--font-mono);
    color: var(--fg-muted);
  }

  .finder-hubs {
    margin-block-start: var(--vs-l);
  }
</style>
