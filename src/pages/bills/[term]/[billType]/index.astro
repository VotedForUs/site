---
/**
 * One type of bill in one congress that has a recorded vote.
 * URL: /bills/[term]/[billType]
 *
 * The paths come from the bills collection, which is what the incremental
 * build tracks; the rows come from the finder index, so the list and the
 * search field never disagree about what a bill is called or where it stands.
 */
import Layout from '../../../../layouts/Layout.astro';
import BillList from '../../../../components/BillList.astro';
import { getCollection } from 'astro:content';
import { getBuildManifest } from '../../../../utils/buildManifest.js';
import { readFinderIndex } from '../../../../utils/finderIndex';
import { billsOfTerm, typePrefix } from '../../../../utils/billList.js';
import { withBaseUrl } from '../../../../utils/withBaseUrl';

export async function getStaticPaths() {
  const allBills = await getCollection('bills');
  const changedBillIds = getBuildManifest()?.changedIds['bills-loader'];
  const lists = new Map<string, typeof allBills>();
  for (const bill of allBills) {
    if (!bill.data.congress || !bill.data.type) continue;
    const key = `${bill.data.congress}:::${bill.data.type.toLowerCase()}`;
    const list = lists.get(key);
    if (list) list.push(bill);
    else lists.set(key, [bill]);
  }
  return [...lists.entries()]
    .filter(([, bills]) => !changedBillIds || bills.some(b => changedBillIds.has(b.id)))
    .map(([key]) => {
      const [term, billType] = key.split(':::');
      return { params: { term, billType } };
    });
}

const { term, billType } = Astro.params;
const congress = parseInt(term);
const base = import.meta.env.BASE_URL;
const termRows = billsOfTerm(readFinderIndex().bills ?? [], term);
const rows = billsOfTerm(termRows, term, billType);
const prefix = typePrefix(billType);
---

<Layout
  title={`${prefix} bills — ${congress}th Congress`}
  description={`${prefix} bills of the ${congress}th Congress that have a recorded vote.`}
  breadcrumbLabels={{ [billType]: prefix }}
>
  <section class="section stack">
    <h1>{prefix} — {congress}th Congress</h1>
    {rows.length > 0 ? (
      <Fragment>
        <p>{rows.length} with a recorded vote, grouped by what happened to them. Newest action first.</p>
        <BillList termRows={termRows} rows={rows} term={term} type={billType} />
      </Fragment>
    ) : (
      <div class="form-actions">
        <p>No {prefix} of the {congress}th has a recorded vote.</p>
        <a href={withBaseUrl(`/bills/${term}`, base)}>All bills of the {congress}th</a>
      </div>
    )}
  </section>
</Layout>
