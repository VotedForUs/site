---
import Layout from '../../../../layouts/Layout.astro';
import BillsTable from '../../../../components/BillsTable.astro';
import { getCollection } from 'astro:content';
import { getBuildManifest } from '../../../../utils/buildManifest.js';

export async function getStaticPaths() {
  const allBills = await getCollection('bills');
  const manifest = getBuildManifest();
  const changedBillIds = manifest?.changedIds['bills-loader'];
  const pathMap = new Map<string, typeof allBills>();
  for (const bill of allBills) {
    if (!bill.data.congress || !bill.data.type) continue;
    const key = `${bill.data.congress}:::${bill.data.type.toLowerCase()}`;
    const existing = pathMap.get(key) ?? [];
    existing.push(bill);
    pathMap.set(key, existing);
  }
  return [...pathMap.entries()]
    .filter(([key, bills]) => !changedBillIds || bills.some(b => changedBillIds.has(b.id)))
    .map(([key, bills]) => {
      const [congress, billType] = key.split(':::');
      return {
        params: { term: congress, billType },
        props: { bills: bills.filter(b => (b.data.actions?.actions?.length ?? 0) > 0) },
      };
    });
}

const { term, billType } = Astro.params;
const { bills } = Astro.props;
const normalizedBillType = billType.toUpperCase();
const congressionalTerm = parseInt(term);

const pageTitle = `${normalizedBillType} Bills - ${congressionalTerm}th Congress`;
---

<Layout title={pageTitle}>
  <h1>{normalizedBillType} Bills - {congressionalTerm}th Congress</h1>
  
  <p>Total bills with votes: {bills.length}</p>
  
  {bills.length > 0 ? (
    <BillsTable bills={bills} />
  ) : (
    <p>No bills found for the {congressionalTerm}th Congress.</p>
  )}
</Layout>
