---
/**
 * One bill: what it is, where it stands, the votes recorded on it, and
 * everything that has happened to it.
 * URL: /bills/[term]/[billType]/[billNumber]
 */
import Layout from '../../../../../layouts/Layout.astro';
import { getEntry, getCollection } from 'astro:content';
import { getBillState, isVotePassed } from '@votedforus/votes';
import type { BillActionWithVotes } from '@votedforus/votes/types';
import { getBestBillTitle, getBillSourceTitle } from '../../../../../utils/billTitle.js';
import EditorialTitleLink from '../../../../../components/EditorialTitleLink.astro';
import VoteTable, { type VoteTableVote } from '../../../../../components/VoteTable.astro';
import BillTimeline from '../../../../../components/BillTimeline.astro';
import { applyBillsPerTypeLimit } from '../../../../../buildConfig';
import { shouldBuildPage } from '../../../../../utils/buildManifest.js';
import { BILL_STATUS_LABELS, typePrefix } from '../../../../../utils/billList.js';
import { formatLegislationIdentifier, formatLegislationTypeLabel } from '../../../../../utils/billLegislationFormat.js';
import { formatDate } from '../../../../../utils/formatDate';
import { formatVoteForAgainst } from '../../../../../utils/formatVoteForAgainst';

export async function getStaticPaths() {
  const allBills = await getCollection('bills');
  return applyBillsPerTypeLimit(allBills)
    .filter(bill => shouldBuildPage('bills-loader', bill.id))
    .map(bill => ({
      params: {
        term: String(bill.data.congress),
        billType: String(bill.data.type).toLowerCase(),
        billNumber: String(bill.data.number),
      },
    }));
}

/** The parts of a bill this page reads. */
type BillData = {
  type: string;
  number: string;
  congress: number;
  title?: string;
  introducedDate?: string;
  originChamber?: string;
  legislationUrl?: string;
  lastActionDate?: string;
  latestAction?: { text: string; actionDate: string };
  laws?: Array<{ number?: string; type?: string }>;
  actions?: { actions?: BillActionWithVotes[] };
  [key: string]: unknown;
};

const { term, billType, billNumber } = Astro.params;

let pageError: Error | null = null;
let bill: BillData | null = null;
let actions: BillActionWithVotes[] = [];
let voteRows: VoteTableVote[] = [];
let voteLabels: Record<string, string> = {};
let pageTitle = 'Bill';
let identifier = '';
let displayTitle = '';
let billSourceTitle: string | undefined;
let facts: string[] = [];

try {
  const congressionalTerm = parseInt(term);
  const normalizedBillType = billType.toUpperCase();

  const billId = `${congressionalTerm}-${normalizedBillType}-${billNumber}`;
  let billEntry = await getEntry('bills', billId);
  if (!billEntry) {
    const allBills = await getCollection('bills');
    billEntry = allBills.find(
      (e) =>
        e.data.congress === congressionalTerm &&
        String(e.data.type).toUpperCase() === normalizedBillType &&
        String(e.data.number) === String(billNumber)
    );
  }
  if (!billEntry) {
    throw new Error(`Bill not found: ${normalizedBillType} ${billNumber} in Congress ${congressionalTerm}`);
  }

  bill = billEntry.data as BillData;
  const resolvedBillId = billEntry.id ?? billId;
  identifier = formatLegislationIdentifier(billType, String(billNumber));
  displayTitle = getBestBillTitle(bill);
  billSourceTitle = getBillSourceTitle(congressionalTerm, normalizedBillType, billNumber);
  actions = bill.actions?.actions || [];

  // The vote list reads the recordedVotes collection directly: the same rows
  // a member's record renders, from the same source.
  const billVoteEntries = (await getCollection('recordedVotes'))
    .filter((e) => e.data.billId === resolvedBillId)
    .sort((a, b) => a.data.voteNumber - b.data.voteNumber);
  voteRows = billVoteEntries.map((e) => ({ id: e.id, ...e.data }));
  // What the timeline calls each vote: the outcome, and the tally when a roll
  // was called.
  voteLabels = Object.fromEntries(billVoteEntries.map((e) => {
    const tally = formatVoteForAgainst(e.data as Parameters<typeof formatVoteForAgainst>[0]);
    const outcome = isVotePassed(e.data.result) ? 'passed' : 'failed';
    return [e.id, `${e.data.chamber ?? 'Recorded'} vote: ${outcome}${tally ? ` ${tally}` : ''} →`];
  }));

  // One muted line under the title: what kind of thing this is and where it stands.
  const state = getBillState(bill as Parameters<typeof getBillState>[0]);
  const law = bill.laws?.[0];
  // H.R. and S. are labelled "act" for the sentence a vote card writes; on
  // its own page a measure that may never pass is a bill.
  const typeLabel = formatLegislationTypeLabel(billType);
  const kind = typeLabel === 'act' ? 'bill' : typeLabel;
  facts = [
    `${congressionalTerm}th Congress`,
    bill.originChamber ? `${bill.originChamber} ${kind}` : kind,
    law?.number ? `${BILL_STATUS_LABELS[state]} — ${law.type ?? 'Public Law'} ${law.number}` : (BILL_STATUS_LABELS[state] ?? state),
  ];

  pageTitle = `${identifier} — ${displayTitle}`;
} catch (err) {
  pageError = err instanceof Error ? err : new Error(String(err));
  pageTitle = 'Error';
}

const lastActionDate = bill?.lastActionDate ?? bill?.latestAction?.actionDate;
---

<Layout
  title={pageTitle}
  description={bill ? `${identifier}, ${term}th Congress: ${displayTitle}. Every recorded vote on it and how each member voted.` : undefined}
  error={pageError}
  errorTitle="Bill page error"
  breadcrumbLabels={bill ? { [billType]: typePrefix(billType), [billNumber]: identifier } : undefined}
>
  {bill && (
    <>
      <header class="record-head">
        <span class="row-id">{identifier}</span>
        <div class="record-main">
          <h1>{displayTitle}<EditorialTitleLink congress={bill.congress} type={bill.type} number={bill.number} /></h1>
          <p class="record-meta">{facts.join(' · ')}</p>
        </div>
        <p class="record-count">{`${voteRows.length} ${voteRows.length === 1 ? 'vote' : 'votes'}`}</p>
      </header>

      <dl class="bill-facts">
        {bill.latestAction && (
          <div>
            <dt>latest action</dt>
            <dd>
              {bill.latestAction.text}
              {lastActionDate && <time class="fact-date" datetime={lastActionDate}>{formatDate(lastActionDate)}</time>}
            </dd>
          </div>
        )}
        {bill.introducedDate && (
          <div>
            <dt>introduced</dt>
            <dd><time datetime={bill.introducedDate}>{formatDate(bill.introducedDate)}</time></dd>
          </div>
        )}
        {billSourceTitle && displayTitle !== billSourceTitle && (
          <div>
            <dt>official title</dt>
            <dd>{billSourceTitle}</dd>
          </div>
        )}
        {bill.legislationUrl && (
          <div>
            <dt>source</dt>
            <dd><a href={bill.legislationUrl} rel="noopener">{identifier} on Congress.gov</a></dd>
          </div>
        )}
      </dl>

      {voteRows.length > 0
        ? <VoteTable votes={voteRows} variant="bill" />
        : <p>No recorded vote on this bill yet.</p>}
      <BillTimeline actions={actions} voteLabels={voteLabels} />
    </>
  )}
</Layout>

<style>
  .bill-facts {
    display: grid;
    gap: var(--pad-s);
    margin: 0 0 var(--vs-m);
  }

  .bill-facts > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--pad-m);
    align-items: baseline;
  }

  .bill-facts dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
  }

  .bill-facts dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .bill-facts time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  .bill-facts .fact-date {
    display: block;
  }

  @media (max-width: 560px) {
    .bill-facts > div { grid-template-columns: 1fr; gap: 0; }
  }
</style>
