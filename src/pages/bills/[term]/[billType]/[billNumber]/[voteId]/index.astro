---
import Layout from '../../../../../../layouts/Layout.astro';
import EditorialVoteActionLink from '../../../../../../components/EditorialVoteActionLink.astro';
import { getEntry, getCollection } from 'astro:content';
import { getBestBillTitle, getEditorialVoteAction } from '../../../../../../content.config';

export async function getStaticPaths() {
  const allVotes = await getCollection('recordedVotes');
  return allVotes.map(vote => {
    // vote.id format: {congress}-{TYPE}-{number}-{voteNumber}
    const parts = vote.id.split('-');
    return {
      params: {
        term: parts[0],
        billType: parts[1].toLowerCase(),
        billNumber: parts[2],
        voteId: parts[3],
      },
    };
  });
}

const { term, billType, billNumber, voteId } = Astro.params;

const normalizedBillType = billType.toUpperCase();
const fullVoteId = `${term}-${normalizedBillType}-${billNumber}-${voteId}`;

const voteEntry = await getEntry('recordedVotes', fullVoteId);
if (!voteEntry) {
  throw new Error(`Vote not found: ${fullVoteId}`);
}

const vote = voteEntry.data;
const question = getEditorialVoteAction(fullVoteId) ?? vote.question;
const billId = vote.billId;
const billEntry = await getEntry('bills', billId);
const billTitle = billEntry?.data ? getBestBillTitle(billEntry.data) : (vote.billTitle ?? '');

// Build table rows: state-district | name | party | vote. Join with legislators.
const chamber = vote.chamber?.toLowerCase();
const collectionName = chamber === 'senate' ? 'senators' : 'representatives';
const votesMap = vote.votes ?? {};
const rows: { bioguideId: string; stateDistrict: string; name: string; party: string; vote: string }[] = [];

for (const [bioguideId, voteCast] of Object.entries(votesMap)) {
  const legEntry = await getEntry(collectionName, bioguideId);
  const leg = legEntry?.data;
  const state = leg?.state ?? '';
  const district = leg?.district != null ? `-${leg.district}` : '';
  const stateDistrict = chamber === 'senate' ? state : `${state}${district}`;
  rows.push({
    bioguideId,
    stateDistrict,
    name: leg?.name ?? leg?.nameTitle ?? bioguideId,
    party: leg?.party ?? '',
    vote: voteCast as string,
  });
}

// Sort by state then name (last name)
rows.sort((a, b) => {
  const stateCmp = a.stateDistrict.localeCompare(b.stateDistrict);
  if (stateCmp !== 0) return stateCmp;
  return a.name.localeCompare(b.name);
});

const voteTitle = question ?? `Vote ${voteId}`;
const pageTitle = `${voteTitle} - ${billTitle}`;
---

<Layout title={pageTitle}>
  <h1>{voteTitle}<EditorialVoteActionLink voteId={fullVoteId} action={vote.question} /></h1>
  <p><strong>Bill:</strong> {billTitle}</p>
  <p><strong>Chamber:</strong> {vote.chamber} — Roll #{vote.rollNumber} · {vote.result}{vote.finalChamberVote && <strong> · Final chamber vote</strong>}</p>
  {vote.voteUrl && <p><a href={vote.voteUrl} target="_blank" rel="noopener noreferrer">View on official site</a></p>}

  <h2>Votes ({rows.length})</h2>
  <action-table class="tbl" sort="Name" direction="ascending" store="vote-detail-table">
  <table>
    <thead>
      <tr>
        <th data-col={chamber === 'senate' ? 'State' : 'State-District'}>{chamber === 'senate' ? 'State' : 'State-District'}</th>
        <th>Name</th>
        <th>Party</th>
        <th>Vote</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td>{r.stateDistrict}</td>
          <td><a href={`${import.meta.env.BASE_URL}bills/${term}/${billType}/${billNumber}/${voteId}/${r.bioguideId}`}>{r.name}</a></td>
          <td>{r.party}</td>
          <td>{r.vote}</td>
        </tr>
      ))}
    </tbody>
  </table>
  </action-table>
</Layout>
