---
import Layout from '../../../../../../layouts/Layout.astro';
import EditorialVoteActionLink from '../../../../../../components/EditorialVoteActionLink.astro';
import VoteRoll from '../../../../../../components/VoteRoll.astro';
import { getEntry, getCollection } from 'astro:content';
import { getBestBillTitle } from '../../../../../../utils/billTitle.js';
import { getEditorialVoteAction } from '../../../../../../utils/editorial.js';
import { getLimitedBillIds } from '../../../../../../buildConfig';
import { shouldBuildPage } from '../../../../../../utils/buildManifest.js';
import type { LegislatorSmall } from '@votedforus/votes/types';
import { memberCastsForDisplay, isConsentMembershipVote } from '../../../../../../utils/memberCastsForDisplay.js';
import { toVoteRollRow } from '../../../../../../utils/voteRollRows.js';
import { proceduralVoteKindFromRecordType } from '../../../../../../utils/voteCastKind.js';
import { actionOptionLabel } from '../../../../../../utils/legislatorVoteDisplay.js';

export async function getStaticPaths() {
  const limitedBillIds = await getLimitedBillIds();
  const allVotes = await getCollection('recordedVotes');
  return allVotes
    .filter(vote => limitedBillIds.has(vote.data.billId) && shouldBuildPage('recorded-votes-loader', vote.id))
    .map(vote => {
      const parts = vote.id.split('-');
      return {
        params: {
          term: parts[0],
          billType: parts[1].toLowerCase(),
          billNumber: parts[2],
          voteId: parts[3],
        },
      };
    });
}

const { term, billType, billNumber, voteId } = Astro.params;

const normalizedBillType = billType.toUpperCase();
const fullVoteId = `${term}-${normalizedBillType}-${billNumber}-${voteId}`;

const voteEntry = await getEntry('recordedVotes', fullVoteId);
if (!voteEntry) {
  throw new Error(`Vote not found: ${fullVoteId}`);
}

const vote = voteEntry.data;
const question = getEditorialVoteAction(fullVoteId) ?? vote.question;
const billId = vote.billId;
const billEntry = await getEntry('bills', billId);
const billTitle = billEntry?.data ? getBestBillTitle(billEntry.data) : (vote.billTitle ?? '');

const chamber = vote.chamber?.toLowerCase() ?? '';
const votesMap = memberCastsForDisplay(vote);
const consent = isConsentMembershipVote(vote);
const proc = proceduralVoteKindFromRecordType(vote.recordType);
const kindLabel = proc ? actionOptionLabel('Yea', proc) : null;

const rows = [];
for (const [bioguideId, voteCast] of Object.entries(votesMap)) {
  const legEntry = await getEntry('legislators', bioguideId);
  rows.push(toVoteRollRow(bioguideId, voteCast, legEntry?.data as LegislatorSmall | undefined, chamber));
}

const voteTitle = question ?? `Vote ${voteId}`;
const pageTitle = `${voteTitle} - ${billTitle}`;
const rollLine = [
  vote.chamber,
  vote.rollNumber ? `Roll #${vote.rollNumber}` : kindLabel,
  vote.result,
  vote.finalChamberVote ? 'Final chamber vote' : null,
].filter(Boolean).join(' · ');
---

<Layout title={pageTitle}>
  <h1>{voteTitle}<EditorialVoteActionLink voteId={fullVoteId} action={vote.question} /></h1>
  <p><strong>Bill:</strong> {billTitle}</p>
  <p><strong>Chamber:</strong> {rollLine}</p>
  {vote.voteUrl && <p><a href={vote.voteUrl} target="_blank" rel="noopener noreferrer">View on official site</a></p>}

  <h2>Votes ({rows.length})</h2>
  <VoteRoll
    rows={rows}
    stateHeader={chamber === 'senate' ? 'Seat' : 'District'}
    sortGroupName={`vr-${fullVoteId}`}
    voteId={fullVoteId}
    consent={consent}
    kindLabel={kindLabel}
  />
</Layout>
