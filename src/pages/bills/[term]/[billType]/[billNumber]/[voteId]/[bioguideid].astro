---
import Layout from '../../../../../../layouts/Layout.astro';
import Voted from '../../../../../../components/Voted.astro';
import { getEntry, getCollection } from 'astro:content';
import { getBestBillTitle } from '../../../../../../content.config';

export async function getStaticPaths() {
  const allVotes = await getCollection('recordedVotes');
  const paths: { params: { term: string; billType: string; billNumber: string; voteId: string; bioguideid: string } }[] = [];
  for (const vote of allVotes) {
    const parts = vote.id.split('-');
    const term = parts[0];
    const billType = parts[1].toLowerCase();
    const billNumber = parts[2];
    const voteId = parts[3];
    for (const bioguideid of Object.keys(vote.data.votes ?? {})) {
      paths.push({ params: { term, billType, billNumber, voteId, bioguideid } });
    }
  }
  return paths;
}

const { term, billType, billNumber, voteId, bioguideid } = Astro.params;

const normalizedBillType = billType.toUpperCase();
const fullVoteId = `${term}-${normalizedBillType}-${billNumber}-${voteId}`;
const billId = `${term}-${normalizedBillType}-${billNumber}`;

const voteEntry = await getEntry('recordedVotes', fullVoteId);
const billEntry = await getEntry('bills', billId);
const legEntry = await getEntry('legislators', bioguideid);

if (!voteEntry || !billEntry || !legEntry) {
  throw new Error('Vote, bill, or legislator not found');
}

const vote = voteEntry.data;
const bill = billEntry.data;
const legislator = legEntry.data;
const voteCast = vote.votes?.[bioguideid] ?? '';

const billTitle = getBestBillTitle(bill);
const trailingText = vote.finalChamberVote ? billTitle : `${vote.actionText ?? `roll call #${vote.rollNumber}`} on ${billTitle}`;
const pageTitle = `${legislator.nameTitle} - ${bill.type} ${bill.number}`;
---

<Layout title={pageTitle}>
  <Voted nameTitle={legislator.nameTitle} voteCast={voteCast} trailingText={trailingText} />
</Layout>
