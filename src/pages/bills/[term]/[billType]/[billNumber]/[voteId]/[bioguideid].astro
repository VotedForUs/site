---
/**
 * Redirect page: alias for /v/[voteId]/[bioguideId].
 *
 * - meta refresh redirects browsers to the canonical short URL
 * - disableIndexing=true prevents search engines from indexing this duplicate
 * - socialCardPath mirrors the canonical page so social crawlers that don't
 *   follow meta refresh still get the correct OG image
 */
import Layout from '../../../../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getLimitedBillIds } from '../../../../../../buildConfig';
import { shouldBuildPage } from '../../../../../../utils/buildManifest.js';

export async function getStaticPaths() {
  const limitedBillIds = await getLimitedBillIds();
  const allVotes = await getCollection('recordedVotes');
  const paths: {
    params: {
      term: string;
      billType: string;
      billNumber: string;
      voteId: string;
      bioguideid: string;
    };
    props: { canonicalVoteId: string };
  }[] = [];

  for (const vote of allVotes.filter(v => limitedBillIds.has(v.data.billId))) {
    const [term, billType, billNumber, voteSegment] = vote.id.split('-');
    for (const bioguideid of Object.keys(vote.data.votes ?? {})) {
      if (shouldBuildPage('legislator-votes-loader', `${bioguideid}-${vote.id}`)) {
        paths.push({
          params: { term, billType: billType.toLowerCase(), billNumber, voteId: voteSegment, bioguideid },
          props: { canonicalVoteId: vote.id },
        });
      }
    }
  }
  return paths;
}

const { bioguideid } = Astro.params;
const { canonicalVoteId } = Astro.props;

const canonicalUrl = `${import.meta.env.BASE_URL}v/${canonicalVoteId}/${bioguideid}`;
const socialCardPath = `/social-cards/v/${canonicalVoteId}/${bioguideid}.png`;
---

<Layout
  title={`${canonicalVoteId}/${bioguideid}`}
  socialCardPath={socialCardPath}
  disableIndexing={true}
  redirect={canonicalUrl}
>
  <p>Redirecting to <a href={canonicalUrl}>{canonicalUrl}</a>…</p>
</Layout>
