---
import Layout from '../../../layouts/Layout.astro';
import BillsTable from '../../../components/BillsTable.astro';
import { getCollection } from 'astro:content';
import { getBuildManifest } from '../../../utils/buildManifest.js';

export async function getStaticPaths() {
  const allBills = await getCollection('bills');
  const manifest = getBuildManifest();
  // Rebuild term index if no manifest (full build) or any bill in that term changed
  const changedBillIds = manifest?.changedIds['bills-loader'];
  const terms = [...new Set(allBills.map(bill => String(bill.data.congress)))];
  return terms
    .filter(term => !changedBillIds || allBills.some(b => String(b.data.congress) === term && changedBillIds.has(b.id)))
    .map(term => ({
      params: { term },
      props: { bills: allBills.filter(b => String(b.data.congress) === term) },
    }));
}

const { term } = Astro.params;
const { bills } = Astro.props;
const congressionalTerm = parseInt(term);

const pageTitle = `${congressionalTerm}th Congress - Bills with Votes`;
---

<Layout title={pageTitle}>
  <h1>{congressionalTerm}th Congress - Bills with Votes</h1>
  
  <p>Total bills: {bills.length}</p>
  
  {bills.length > 0 ? (
    <BillsTable bills={bills} />
  ) : (
    <p>No bills found for the {congressionalTerm}th Congress.</p>
  )}
</Layout>
