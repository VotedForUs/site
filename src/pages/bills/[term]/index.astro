---
import Layout from '../../../layouts/Layout.astro';
import BillsTable from '../../../components/BillsTable.astro';
import { getCollection } from 'astro:content';
import { getBuildManifest } from '../../../utils/buildManifest.js';

export async function getStaticPaths() {
  const allBills = await getCollection('bills');
  const manifest = getBuildManifest();
  // Rebuild term index if no manifest (full build) or any bill in that term changed
  const changedBillIds = manifest?.changedIds['bills-loader'];
  const terms = [...new Set(allBills.map(bill => String(bill.data.congress)))];
  return terms
    .filter(term => !changedBillIds || allBills.some(b => String(b.data.congress) === term && changedBillIds.has(b.id)))
    .map(term => ({
      params: { term },
      props: { bills: allBills.filter(b => String(b.data.congress) === term) },
    }));
}

const { term } = Astro.params;
const { bills } = Astro.props;
const congressionalTerm = parseInt(term);

const pageTitle = `${congressionalTerm}th Congress — bills with recorded votes`;
const base = import.meta.env.BASE_URL;
---

<Layout title={pageTitle} description={`Every bill of the ${congressionalTerm}th Congress that has a recorded floor vote.`}>
  <section class="section stack">
    <h1>{congressionalTerm}th Congress</h1>
    <p>{bills.length} bills with a recorded vote, grouped by what happened to them.</p>
    {bills.length > 0 ? (
      <BillsTable bills={bills} />
    ) : (
      <div class="form-actions">
        <p>No bills of the {congressionalTerm}th have a recorded vote yet.</p>
        <a href={base}>Find a member or a bill</a>
      </div>
    )}
  </section>
</Layout>
