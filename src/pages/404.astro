---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Not found" disableIndexing>
  <section class="section stack">
    <h1>Not found</h1>
    <p>That address is not a page on this site.</p>
    <div class="form-actions">
      <a href={base}>Find a member or a bill</a>
      <a href={`${base}bills/119`}>All bills of the 119th</a>
      <a href={`${base}members`}>All members</a>
    </div>
  </section>
</Layout>
