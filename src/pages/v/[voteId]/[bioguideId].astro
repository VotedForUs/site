---
import Layout from '../../../layouts/Layout.astro';
import Voted from '../../../components/Voted.astro';
import { getCollection } from 'astro:content';
import { getLimitedBillIds } from '../../../buildConfig';
import { shouldBuildPage } from '../../../utils/buildManifest.js';
import { resolveLegislatorVoteView } from '../../../utils/resolveLegislatorVoteViewAstro.js';
import { toPageVotedProps } from '../../../utils/legislatorVoteView.js';

export async function getStaticPaths() {
  const limitedBillIds = await getLimitedBillIds();
  const allVotes = await getCollection('recordedVotes');
  const paths: { params: { voteId: string; bioguideId: string } }[] = [];
  for (const vote of allVotes.filter(v => limitedBillIds.has(v.data.billId))) {
    for (const bioguideId of Object.keys(vote.data.votes ?? {})) {
      if (shouldBuildPage('legislator-votes-loader', `${bioguideId}-${vote.id}`)) {
        paths.push({ params: { voteId: vote.id, bioguideId } });
      }
    }
  }
  return paths;
}

const { voteId, bioguideId } = Astro.params;
const normalizedVoteId = voteId;
const result = await resolveLegislatorVoteView({
  voteId: normalizedVoteId,
  bioguideId,
});

if (!result.ok) {
  throw new Error(`Legislator vote not found (${result.reason}): ${bioguideId}/${normalizedVoteId}`);
}

const view = result.view;
const votedProps = toPageVotedProps(view);
---

<Layout
  title={view.page.title}
  socialCardPath={view.page.socialCardPath}
>
  <Voted {...votedProps} />
</Layout>
