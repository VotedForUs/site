---
import Layout from '../../../layouts/Layout.astro';
import Voted from '../../../components/Voted.astro';
import { getEntry, getCollection } from 'astro:content';
import { getBestBillTitle } from '../../../utils/billTitle.js';
import { getLimitedBillIds } from '../../../buildConfig';
import { shouldBuildPage } from '../../../utils/buildManifest.js';

export async function getStaticPaths() {
  const limitedBillIds = await getLimitedBillIds();
  const allVotes = await getCollection('recordedVotes');
  const paths: { params: { voteId: string; bioguideId: string } }[] = [];
  for (const vote of allVotes.filter(v => limitedBillIds.has(v.data.billId))) {
    for (const bioguideId of Object.keys(vote.data.votes ?? {})) {
      if (shouldBuildPage('legislator-votes-loader', `${bioguideId}-${vote.id}`)) {
        paths.push({ params: { voteId: vote.id, bioguideId } });
      }
    }
  }
  return paths;
}

const { voteId, bioguideId } = Astro.params;
// vote.id is already normalized (TYPE uppercase) from the collection
const normalizedVoteId = voteId;
const voteEntry = await getEntry('recordedVotes', normalizedVoteId);
if (!voteEntry) {
  throw new Error(`Vote not found: ${normalizedVoteId}`);
}

const vote = voteEntry.data;
const billEntry = await getEntry('bills', vote.billId);
const legEntry = await getEntry('legislators', bioguideId);

if (!billEntry || !legEntry) {
  throw new Error('Bill or legislator not found');
}

const bill = billEntry.data;
const legislator = legEntry.data;
const voteCast = vote.votes?.[bioguideId] ?? '';

const billTitle = getBestBillTitle(bill);
const voteTitle = vote.question ?? `Roll call ${vote.rollNumber}`;
const pageTitle = `${legislator.nameTitle} - ${bill.type} ${bill.number}`;
---

<Layout
  title={pageTitle}
  socialCardPath={`/social-cards/v/${normalizedVoteId}/${bioguideId}.png`}
>
  <Voted
    nameTitle={legislator.nameTitle}
    voteCast={voteCast}
    voteTitle={voteTitle}
    billTitle={billTitle}
  />
</Layout>
