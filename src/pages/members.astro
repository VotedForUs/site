---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Members - Congressional Vote Analysis" description="Browse current members of Congress by chamber">
  <h2>Members</h2>
  <p>View current members of Congress by chamber.</p>
  <ul>
    <li><a href={`${base}members/senate`}>Senate</a> - Current senators</li>
    <li><a href={`${base}members/house`}>House of Representatives</a> - Current representatives</li>
  </ul>
</Layout>
