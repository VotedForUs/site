---
/**
 * One legislator on a recorded vote, as a table row.
 *
 * The name is the link to the canonical member×vote URL. Opening the card is
 * the row invoker's job (`command="show-modal"`), added by the roll.
 */
import type { VoteRollRowWithOrders } from '../utils/voteRollSortOrders';
import { partyAbbrev } from '../utils/voteRollDisplay';
import { stateRollGroupKey } from '../utils/voteRollDisplay';

interface Props {
  /** Row with sort-order ranks. */
  row: VoteRollRowWithOrders;
  /** Href to this member's vote page. */
  memberHref: string;
  /** When true, this is the row the card is open on. */
  selected?: boolean;
}

const { row: r, memberHref, selected = false } = Astro.props;
const pAbbr = partyAbbrev(r.party);
---

<tr
  data-row
  data-bioguide={r.bioguideId}
  data-state-group={stateRollGroupKey(r.stateDistrict)}
  data-state-district={r.stateDistrict}
  data-name={r.name}
  data-last-name={r.lastName}
  data-party={r.party}
  data-vote={r.vote}
  data-order-state={r.orderState}
  data-order-name={r.orderName}
  data-order-party={r.orderParty}
  data-order-vote={r.orderVote}
  aria-current={selected ? 'true' : undefined}
>
  <td>{r.stateDistrict}</td>
  <td>
    <a class="vote-roll-name" href={memberHref} data-bioguide={r.bioguideId}>{r.name}</a>
  </td>
  <td><span title={r.party}>{pAbbr}</span></td>
  <td>{r.vote}</td>
</tr>
