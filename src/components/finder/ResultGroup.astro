---
/**
 * One labelled, counted result group — the shape, defined once, for the same
 * two uses as `ResultRow.astro`: the element's `<template>`, and the rows that
 * ship in the HTML.
 */
interface Props {
  label?: string;
  count?: number;
}

const { label, count } = Astro.props;
---

<section class="result-group">
  <h3 class="group-label">
    <span data-label>{label}</span>
    <span data-count>{count}</span>
  </h3>
  <div data-rows><slot /></div>
</section>
