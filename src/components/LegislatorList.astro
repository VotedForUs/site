---
interface Legislator {
  nameTitle?: string;
  party?: string;
}

interface LegislatorEntry {
  id: string;
  data: Legislator;
}

export interface Props {
  legislators: LegislatorEntry[];
}

const { legislators } = Astro.props;
---

<ul class="legislator-list">
  {legislators.map(entry => {
    const legislator = entry?.data;
    if (!legislator) return null;
    return (
      <li>
        <a href={`${import.meta.env.BASE_URL}legislators/${entry.id}`}>{legislator.nameTitle ?? 'N/A'} ({legislator.party ?? 'N/A'})</a>
      </li>
    );
  })}
</ul>

<style>
  .legislator-list {
    list-style: none;
    padding: 0;
    margin: 0;
    column-count: 1;
    column-gap: 2rem;
  }

  .legislator-list li {
    break-inside: avoid;
    padding: 0.25rem 0;
  }

  @media (min-width: 640px) {
    .legislator-list {
      column-count: 2;
    }
  }

  @media (min-width: 1024px) {
    .legislator-list {
      column-count: 3;
    }
  }

  @media (min-width: 1280px) {
    .legislator-list {
      column-count: 4;
    }
  }
</style>
