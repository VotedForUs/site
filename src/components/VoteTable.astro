---
/**
 * The list of recorded votes, on a bill or on one member's record.
 *
 * Both variants are the same rows — `ResultRow.astro`, like every other list
 * on the site — with the member variant adding what that member did. The
 * chamber leads in its own line, the question is the title, and the result
 * trails.
 *
 * On a vote with no roll call, the member's position still reads **Yea**: any
 * member may demand a recorded vote, so not demanding one is consent to the
 * outcome. That claim is only defensible while the kind of vote is named with
 * it, so the kind chip and the cast tag are rendered together, always. The
 * stored values `UC` and `vv` never reach the page.
 */
import ResultGroup from './ResultGroup.astro';
import ResultRow from './ResultRow.astro';
import { isVotePassed } from '@votedforus/votes';
import { getEditorialVoteAction } from '../utils/editorial.js';
import { castTag } from '../utils/legislatorVoteDisplay.js';
import { votePath, voteMemberPath } from '../utils/voteLinks.js';
import { formatVoteForAgainst } from '../utils/formatVoteForAgainst';

/** One recorded vote, as the `recordedVotes` collection stores it. */
export type VoteTableVote = {
  id: string;
  chamber?: string;
  question?: string;
  result?: string;
  date?: string;
  actionDate?: string;
  actionText?: string;
  rollNumber?: number;
  votes?: Record<string, string>;
  votePartyTotal?: unknown;
  finalChamberVote?: boolean;
};

interface Props {
  votes: VoteTableVote[];
  /** `bill` lists every vote on a bill; `member` adds what one member did. */
  variant?: 'bill' | 'member';
  /** Required by the member variant, ignored by the bill variant. */
  bioguideId?: string;
  /** The vote the page is currently showing. */
  selectedVoteId?: string;
  label?: string;
}

const { votes, variant = 'bill', bioguideId, selectedVoteId, label = 'recorded votes' } = Astro.props;
const base = import.meta.env.BASE_URL;

const rows = votes.map((vote) => {
  const cast = variant === 'member' && bioguideId ? vote.votes?.[bioguideId] : undefined;
  const tag = cast ? castTag(cast) : null;
  return {
    vote,
    href: variant === 'member' && bioguideId
      ? voteMemberPath(vote.id, bioguideId, base)
      : votePath(vote.id, base) ?? undefined,
    question: getEditorialVoteAction(vote.id) ?? vote.question,
    date: (vote.actionDate ?? vote.date ?? '').slice(0, 10),
    passed: isVotePassed(vote.result),
    forAgainst: formatVoteForAgainst(vote as Parameters<typeof formatVoteForAgainst>[0]),
    // A vote with no roll call reads as a Yea by consent, with the kind named
    // beside it — never the stored `UC` or `vv`. See castTag().
    castLabel: tag?.label,
    kindLabel: tag?.kind ?? null,
  };
});
---

{rows.length > 0 && (
  <ResultGroup label={label} count={rows.length}>
    {rows.map(({ vote, href, question, date, passed, forAgainst, castLabel, kindLabel }) => (
      <ResultRow href={href} selected={vote.id === selectedVoteId}>
        <Fragment slot="lead">
          <span class="vote-lead">
            <span class="vote-chamber">{vote.chamber}</span>
            {/* A vote with no roll call carries roll 0, which names nothing. */}
            {vote.rollNumber ? <span class="vote-roll">{`roll ${vote.rollNumber}`}</span> : null}
          </span>
        </Fragment>

        <Fragment slot="title">{question}</Fragment>

        <Fragment slot="meta">
          {[vote.actionText, date].filter(Boolean).join(' · ')}
        </Fragment>

        <Fragment slot="trailing">
          {castLabel && (
            <span class="cast-tag" data-cast={castLabel.toLowerCase()}>{castLabel}</span>
          )}
          {kindLabel && <span class="kind-chip">{kindLabel}</span>}
          {!castLabel && (
            <>
              <span class="vote-result">{passed ? 'passed' : 'failed'}</span>
              {forAgainst && <span class="kind-chip">{forAgainst}</span>}
            </>
          )}
        </Fragment>
      </ResultRow>
    ))}
  </ResultGroup>
)}
