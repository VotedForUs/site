---
interface Props {
  nameTitle: string;
  voteCast: string;
  trailingText: string;
}
const { nameTitle, voteCast, trailingText } = Astro.props;
const isUC = voteCast === 'UC';
---
<div class="voted-card">
  <p class="voted-card__text">
    {nameTitle}
    {isUC ? (
      <strong>joined Unanimous Consent</strong>
    ) : (
      <> voted <strong>{voteCast || '—'}</strong></>
    )}
    {' on the '}
    {trailingText}.
  </p>
</div>

<style>
  .voted-card {
    width: 1200px;
    height: 630px;
    margin: 0;
    padding: 2rem 3rem;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fafafa;
    color: #1a1a1a;
  }

  .voted-card__text {
    font-family: 'Source Sans 3', system-ui, -apple-system, sans-serif;
    font-size: 2.25rem;
    line-height: 1.4;
    margin: 0;
    max-width: 100%;
    text-align: center;
  }

  .voted-card__text strong {
    font-weight: 700;
  }
</style>
