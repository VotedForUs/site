---
/**
 * The full roll for one recorded vote. Bill path only.
 *
 * Default view is state-grouped, with the reader's delegation first when
 * `homeState` is set. Sort and find-a-member are added by `vfu-vote-roll`.
 * A UC or voice vote has no sort-by-cast control — every row is Yea by consent.
 */
import type { VoteRollRow } from '../utils/voteRollSortOrders';
import { addVoteRollSortOrders } from '../utils/voteRollSortOrders';
import { voteMemberPath } from '../utils/voteLinks.js';
import { buildStateGroups, liftHomeState } from '../utils/voteRollView.js';
import LegislatorVoteRow from './VoteRollRow.astro';
import './vote-roll.css';

interface Props {
  /** Legislator rows from the vote page (any order). */
  rows: VoteRollRow[];
  /** First column header, e.g. State vs Seat. */
  stateHeader: string;
  /** Unique `name=` leftover from the radio-sort UI; kept as an id prefix. */
  sortGroupName: string;
  /** Full recorded-vote id (`119-HR-2616-184`). */
  voteId: string;
  /** Two-letter state to lift when the reader arrived from a member. */
  homeState?: string;
  /** True when rows come from `membersAtAction` and every cast is Yea. */
  consent?: boolean;
  /** Visible vote kind for a consent roll (Unanimous Consent / Voice Vote). */
  kindLabel?: string | null;
  /** Bioguide of the row the card is open on. */
  selectedBioguideId?: string;
}

const {
  rows,
  stateHeader,
  sortGroupName,
  voteId,
  homeState,
  consent = false,
  kindLabel = null,
  selectedBioguideId,
} = Astro.props;

const withOrders = addVoteRollSortOrders(rows);
const groups = liftHomeState(buildStateGroups(withOrders), homeState);
const base = import.meta.env.BASE_URL;
---

<vfu-vote-roll data-sort-group={sortGroupName}>
  {kindLabel && (
    <p class="vote-roll-kind">{kindLabel} · {rows.length} members · Yea by consent</p>
  )}

  <label class="vote-roll-find">
    <span>Find a member</span>
    <input type="search" data-filter autocomplete="off" />
  </label>

  <table class="vote-roll-table">
    <thead>
      <tr>
        <th aria-sort="ascending">
          <button type="button" data-sort="state">{stateHeader}</button>
        </th>
        <th aria-sort="none">
          <button type="button" data-sort="name">Name</button>
        </th>
        <th aria-sort="none">
          <button type="button" data-sort="party">Party</button>
        </th>
        {consent ? (
          <th>Vote</th>
        ) : (
          <th aria-sort="none">
            <button type="button" data-sort="cast">Vote</button>
          </th>
        )}
      </tr>
    </thead>
    <tbody>
      {groups.map(({ key, rows: groupRows }) => (
        <>
          <tr class="vote-roll-group" data-group={key}>
            <th colspan="4">{key}</th>
          </tr>
          {groupRows.map((r) => (
            <LegislatorVoteRow
              row={r}
              memberHref={voteMemberPath(voteId, r.bioguideId, base)}
              selected={r.bioguideId === selectedBioguideId}
            />
          ))}
        </>
      ))}
    </tbody>
  </table>
</vfu-vote-roll>

<script>
  import './vfu-vote-roll';
</script>
