---
/**
 * The full roll for one recorded vote, and the card that opens over it.
 *
 * One member's cast on this vote is not a page of its own — there are about
 * 350,000 of those. A name opens the card in place: `vfu-vote-roll` fills the
 * one dialog below from the row and puts `?member=` in the URL.
 *
 * Default view is state-grouped, with the reader's delegation first when
 * `homeState` is set. Sort and find-a-member are added by `vfu-vote-roll`.
 * A UC or voice vote has no sort-by-cast control — every row is Yea by consent.
 */
import type { VoteRollRow } from '../utils/voteRollSortOrders';
import { addVoteRollSortOrders } from '../utils/voteRollSortOrders';
import { voteCardPath, votePath } from '../utils/voteLinks.js';
import { buildLegislatorVoteDisplay } from '../utils/legislatorVoteDisplay.js';
import { stateNameFromCode } from '../utils/stateNames.js';
import { SHARE_STUB_SCOPE } from '../shareConfig.js';
import { seoConfig } from '../../utils/seoConfig';
import { buildStateGroups, liftHomeState } from '../utils/voteRollView.js';
import LegislatorVoteRow from './VoteRollRow.astro';
import VfuVoteCard from './VfuVoteCard.astro';
import './vote-roll.css';

interface Props {
  /** Legislator rows from the vote page (any order). */
  rows: VoteRollRow[];
  /** First column header, e.g. State vs Seat. */
  stateHeader: string;
  /** Unique `name=` leftover from the radio-sort UI; kept as an id prefix. */
  sortGroupName: string;
  /** Full recorded-vote id (`119-HR-2616-184`). */
  voteId: string;
  /** Two-letter state to lift when the reader arrived from a member. */
  homeState?: string;
  /** True when rows come from `membersAtAction` and every cast is Yea. */
  consent?: boolean;
  /** Visible vote kind for a consent roll (Unanimous Consent / Voice Vote). */
  kindLabel?: string | null;
  /** Bioguide of the row the card is open on — stories; pages read the URL. */
  selectedBioguideId?: string;
  /** The question voted on, as the card names it. */
  voteTitle?: string;
  /** The bill's display title, as the card names it. */
  billTitle?: string;
  /** Which chamber's members these are. */
  chamber?: 'sen' | 'rep';
  /** Package `recordType`; makes a consent vote's card name its kind. */
  recordType?: string;
}

const {
  rows,
  stateHeader,
  sortGroupName,
  voteId,
  homeState,
  consent = false,
  kindLabel = null,
  selectedBioguideId,
  voteTitle = '',
  billTitle = '',
  chamber = 'rep',
  recordType,
} = Astro.props;

const withOrders = addVoteRollSortOrders(rows);
const groups = liftHomeState(buildStateGroups(withOrders), homeState);
const base = import.meta.env.BASE_URL;

// The dialog is rendered once with a member in it so every slot exists; the
// element overwrites all of it before the dialog is ever shown.
const first = withOrders[0];
const firstState = first?.stateDistrict.replace(/-.*$/, '') ?? '';
const shell = buildLegislatorVoteDisplay({
  voteCast: first?.vote ?? 'Yea',
  nameTitle: first?.nameTitle ?? first?.name ?? '',
  party: first?.party ?? '',
  stateName: stateNameFromCode(firstState),
  chamber,
  state: firstState,
  recordType,
});
---

<vfu-vote-roll
  data-sort-group={sortGroupName}
  vote-id={voteId}
  vote-title={voteTitle}
  bill-title={billTitle}
  chamber={chamber}
  record-type={recordType}
  base={base}
  share-origin={seoConfig.baseURL}
  share-stub-scope={SHARE_STUB_SCOPE}
  selected={selectedBioguideId}
>
  {kindLabel && (
    <p class="vote-roll-kind">{kindLabel} · {rows.length} members · Yea by consent</p>
  )}

  <label class="vote-roll-find">
    <span>Find a member</span>
    <input type="search" data-filter autocomplete="off" />
  </label>

  <table class="vote-roll-table">
    <thead>
      <tr>
        <th aria-sort="ascending">
          <button type="button" data-sort="state">{stateHeader}</button>
        </th>
        <th aria-sort="none">
          <button type="button" data-sort="name">Name</button>
        </th>
        <th aria-sort="none">
          <button type="button" data-sort="party">Party</button>
        </th>
        {consent ? (
          <th>Vote</th>
        ) : (
          <th aria-sort="none">
            <button type="button" data-sort="cast">Vote</button>
          </th>
        )}
      </tr>
    </thead>
    <tbody>
      {groups.map(({ key, rows: groupRows }) => (
        <>
          <tr class="vote-roll-group" data-group={key}>
            <th colspan="4">{key}</th>
          </tr>
          {groupRows.map((r) => (
            <LegislatorVoteRow
              row={r}
              memberHref={voteCardPath(voteId, r.bioguideId, base)}
              selected={r.bioguideId === selectedBioguideId}
            />
          ))}
        </>
      ))}
    </tbody>
  </table>

  {first && (
    <VfuVoteCard
      voteId={voteId}
      bioguideId={first.bioguideId}
      closeHref={votePath(voteId, base) ?? ''}
      shareUrl=""
      card={{
        nameTitle: first.nameTitle ?? first.name,
        party: first.party,
        stateName: stateNameFromCode(firstState),
        chamber,
        state: firstState,
        imageUrl: first.imageUrl ?? '',
        voteCast: first.vote,
        voteTitle,
        legislationIdentifier: '',
        legislationType: '',
        billTitle,
        displayName: shell.displayName,
        memberSubtitle: shell.memberSubtitle,
        voteVerb: shell.voteVerb,
        emoji: shell.emoji,
        actionLabel: shell.actionLabel,
        bioguideId: first.bioguideId,
      }}
    />
  )}
</vfu-vote-roll>

<script>
  import './vfu-vote-roll';
</script>
