      },
      {
        "actionCode": "H30000",
        "actionDate": "2026-07-22",
        "actionTime": "16:52:13",
        "sourceSystem": {
          "code": 2,
          "name": "House floor actions"
        },
        "text": "Considered as unfinished business. (consideration: CR H5158-5159)",
        "type": "Floor"
      },
      {
        "actionCode": "H8D000",
        "actionDate": "2026-07-22",
        "actionTime": "14:11:51",
        "sourceSystem": {
          "code": 2,
          "name": "House floor actions"
        },
        "text": "POSTPONED PROCEEDINGS - The Chair put the question on agreeing to the resolution. Pursuant to clause 10 of rule 20, the yeas and nays are ordered. Further proceedings are postponed.",
        "type": "Floor"
      },
      {
        "actionCode": "H35000",
        "actionDate": "2026-07-22",
        "actionTime": "14:11:36",
        "sourceSystem": {
          "code": 2,
          "name": "House floor actions"
        },
        "text": "The previous question was ordered pursuant to the rule.",
        "type": "Floor"
      },
      {
        "actionCode": "H34400",
        "actionDate": "2026-07-22",
        "actionTime": "14:11:02",
        "sourceSystem": {
          "code": 2,
          "name": "House floor actions"
        },
        "text": "The House adopted the amendment in the nature of a substitute as agreed to by the Committee of the Whole House on the state of the Union.",
        "type": "Floor"
      },
      {
        "actionCode": "H32600",
        "actionDate": "2026-07-22",
        "actionTime": "14:10:54",
        "sourceSystem": {
          "code": 2,
          "name": "House floor actions"
        },
        "text": "The House rose from the Committee of the Whole House on the state of the Union to report H. Con. Res. 113.",
        "type": "Floor"
      },
      {
        "actionCode": "H8D000",
        "actionDate": "2026-07-22",
        "actionTime": "12:52:39",
        "sourceSystem": {
          "code": 2,
          "name": "House floor actions"
        },
        "text": "GENERAL DEBATE - The Committee of the Whole proceeded with one hour of general debate on H. Con. Res. 113.",
        "type": "Floor"
      },
      {
        "actionCode": "H32020",
        "actionDate": "2026-07-22",
        "actionTime": "12:51:37",
        "sourceSystem": {
          "code": 2,
          "name": "House floor actions"
        },
        "text": "House resolved itself into the Committee of the Whole House on the state of the Union pursuant to H. Res. 1438 and Rule XVIII.",
        "type": "Floor"
      },
      {
        "actionCode": "H32400",
        "actionDate": "2026-07-22",
        "actionTime": "12:51:37",
        "sourceSystem": {
          "code": 2,
          "name": "House floor actions"
        },
        "text": "The Speaker designated the Honorable Craig A. Goldman to act as Chairman of the Committee.",
        "type": "Floor"
      },
      {
        "actionCode": "H8D000",
        "actionDate": "2026-07-22",
        "actionTime": "12:51:06",
        "sourceSystem": {
          "code": 2,
          "name": "House floor actions"
        },
        "text": "Rule provides for consideration of H.R. 8800, H.R. 8884, H. Con. Res. 113, H.R. 7008, H.R. 6955 and H.R. 9770. The resolution provides for consideration of H.R. 8800 under a structured rule and for consideration of H.R. 8884, H. Con. Res. 113, H.R. 7008, H.R. 6955, and H.R. 9770 under a closed rule, with one hour of debate on each measure and one motion to recommit on H.R. 8800, H.R. 8884, H.R. 7008, H.R. 6955, and H.R. 9770.",
        "type": "Floor"
      },
      {
        "actionCode": "H30000",
        "actionDate": "2026-07-22",
        "actionTime": "12:51:01",
        "sourceSystem": {
          "code": 2,
          "name": "House floor actions"
        },
        "text": "Considered under the provisions of rule H. Res. 1438. (consideration: CR H5127-5143)",
        "type": "Floor"
      },
      {
        "actionCode": "H1L210",
        "actionDate": "2026-07-20",
        "actionTime": "20:33:13",
        "sourceSystem": {
          "code": 2,
          "name": "House floor actions"
        },
        "text": "Rules Committee Resolution H. Res. 1438 Reported to House. Rule provides for consideration of H.R. 8800, H.R. 8884, H. Con. Res. 113, H.R. 7008, H.R. 6955 and H.R. 9770. The resolution provides for consideration of H.R. 8800 under a structured rule and for consideration of H.R. 8884, H. Con. Res. 113, H.R. 7008, H.R. 6955, and H.R. 9770 under a closed rule, with one hour of debate on each measure and one motion to recommit on H.R. 8800, H.R. 8884, H.R. 7008, H.R. 6955, and H.R. 9770.",
        "type": "Floor"
      },
