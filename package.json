{
  "name": "@votedforus/site",
  "type": "module",
  "version": "0.0.1",
  "description": "Static website for VotedFor.Us using AstroJS",
  "scripts": {
    "start": "npm run dev",
    "dev": "astro dev",
    "build": "tsx scripts/incremental-check.ts && astro build && npm run _cache:merge && npm run _cache:save",
    "build:test": "BILLS_PER_TYPE_LIMIT=5 LEGISLATORS_LIMIT=40 npm run build",
    "build:full": "FORCE_FULL_REBUILD=true astro build && npm run _cache:save",
    "_cache:merge": "[ -d dist-cache ] && rsync -a --ignore-existing dist-cache/ dist/ || true",
    "_cache:save": "mkdir -p dist-cache && cp -r dist/. dist-cache/ && [ -f .current-digests.json ] && cp .current-digests.json dist-cache/.astro-manifest.json || true",
    "preview": "astro preview",
    "astro": "astro",
    "clean": "rm -rf dist/ ../../dist/site ../../.astro",
    "legislators:generate": "vfu legislators -o src/data/legislators --congress 119 --images public/images/legislators",
    "legislators:generate:fresh": "vfu legislators -o src/data/legislators --congress 119 --images public/images/legislators",
    "voted-bills-sync:generate": "vfu voted-bills-sync -o src/data",
    "build-from-cache": "vfu build-from-cache -o src/data",
    "generate-change-summary": "vfu generate-change-summary --data-dir src/data --changelog-dir src/data/changelog",
    "test": "node --test --experimental-test-coverage --import tsx src/**/*.test.ts scripts/**/*.test.ts",
    "test:types": "astro check",
    "social-cards": "tsx utils/generate-social-cards.ts",
    "analyze-bill-titles": "tsx scripts/analyze-bill-titles.ts",
    "benchmark:cold": "tsx scripts/benchmark.ts --scenario cold",
    "benchmark:warm": "tsx scripts/benchmark.ts --scenario warm",
    "benchmark:report": "tsx scripts/benchmark.ts --report"
  },
  "dependencies": {
    "@votedforus/votes": "^1.0.1",
    "astro": "^6.0.2",
    "astro-seo": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@types/node": "^25.4.0",
    "gitmojis": "^3.15.0",
    "puppeteer": "^24.39.0",
    "semantic-release": "^24.2.9",
    "semantic-release-gitmoji": "^1.6.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
