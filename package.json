{
  "name": "@votedforus/site",
  "type": "module",
  "version": "0.0.1",
  "description": "Static website for VotedFor.Us using AstroJS",
  "scripts": {
    "start": "npm run dev",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "clean": "rm -rf dist/ ../../dist/site ../../.astro",
    "test": "node --test --import tsx src/**/*.test.ts",
    "test:types": "astro check",
    "social-cards": "tsx utils/generate-social-cards.ts",
    "analyze-bill-titles": "tsx scripts/analyze-bill-titles.ts"
  },
  "dependencies": {
    "@votedforus/votes": "^1.0.1",
    "astro": "^6.0.2",
    "astro-seo": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@types/node": "^25.4.0",
    "puppeteer": "^24.39.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
